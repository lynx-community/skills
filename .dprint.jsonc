{
  "lineWidth": 80,
  "indentWidth": 2,
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "always",
  },
  "json": {},
  "malva": {},
  "markup": {},
  "yaml": {},
  "includes": [
    "**/*.{ts,tsx,mts,cts,js,jsx,cjs,mjs,json,jsonc,css,scss,sass,less,html,yml,yaml}",
  ],
  "excludes": [
    ".pnpm-store/**",
    "packages/mcp-servers/devtool-connector/**",
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/dist/**",
    "**/lib/**",
    "**/.rslib/**",
    "**/.turbo/**",
    "**/coverage/**",
    "output/**",
    "target/**",
    "**/test/js/**",
    "**/expected/**",
    "**/rspack-expected/**",
    "**/__swc_snapshots__/**",
    "**/__snapshots__/**",
    "packages/tools/perfetto-trace-processor/vendor/**",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.95.11",
    "npm:@dprint/json@0.20.0",
    "npm:dprint-plugin-malva@0.14.3",
    "npm:dprint-plugin-markup@0.24.0",
    "npm:dprint-plugin-yaml@0.5.1",
  ],
}
