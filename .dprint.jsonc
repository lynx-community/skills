{
  "lineWidth": 80,
  "indentWidth": 2,
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "always",
  },
  "json": {
    "packageJson.applyConventions": true,
  },
  "malva": {},
  "markup": {},
  "yaml": {},
  "includes": [
    "**/*.{ts,tsx,mts,cts,js,jsx,cjs,mjs,json,jsonc,css,scss,sass,less,html,yml,yaml}",
  ],
  "excludes": [
    ".pnpm-store/**",
    "packages/mcp-servers/devtool-connector/**",
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/dist/**",
    "**/lib/**",
    "**/.rslib/**",
    "**/.turbo/**",
    "**/coverage/**",
    "output/**",
    "target/**",
    "**/test/js/**",
    "**/expected/**",
    "**/rspack-expected/**",
    "**/__swc_snapshots__/**",
    "**/__snapshots__/**",
    "packages/tools/perfetto-trace-processor/vendor/**",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
  ],
}
