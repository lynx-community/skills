{
  "name": "agent-lynx",
  "version": "0.14.19",
  "description": "Agent-friendly Lynx DevTool CLI for inspecting and operating Lynx applications.",
  "bin": {
    "agent-lynx": "./dist/index.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./connector": {
      "types": "./src/connector.ts",
      "import": "./src/connector.ts",
      "default": "./src/connector.ts"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts",
      "default": "./src/cli.ts"
    },
    "./bin": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rslib build",
    "test": "node --test 'test/**/*.test.ts'",
    "test:e2e": "node --test --test-concurrency=1 'e2e/**/*.test.ts'",
    "test:e2e:public": "node --test --test-concurrency=1 'e2e/public/**/*.test.ts'"
  },
  "dependencies": {
    "@lynx-js/devtool-connector": "workspace:*",
    "@lynx-js/skill-lynx-devtool": "workspace:*",
    "@lynx-js/skill-lynx-trace-analysis": "0.0.12",
    "@lynx-js/skill-lynx-trace-record": "0.0.6",
    "@lynx-js/trace-processor": "0.0.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rslib/core": "catalog:rstack",
    "@types/node": "^24.19.2",
    "commander": "^14.0.3",
    "core-js": "^3.51.0",
    "obug": "^2.2.1",
    "yaml": "^2.9.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/agent-lynx"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "exports": {
      "./connector": {
        "types": "./dist/connector.d.ts",
        "import": "./dist/connector.mjs",
        "default": "./dist/connector.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.mjs",
        "default": "./dist/cli.mjs"
      },
      "./bin": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
