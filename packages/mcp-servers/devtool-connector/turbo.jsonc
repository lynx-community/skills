{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tags": ["opensource"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": ["dist/**", "public/simulator/*.so", "public/simulator/*.dylib"],
    },
    "build:simulator": {
      "inputs": ["package.json", "scripts/simulator/**"],
      "outputs": ["public/simulator/*.so", "public/simulator/*.dylib"],
    },
  },
}
