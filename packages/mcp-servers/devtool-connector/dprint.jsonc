{
  "typescript": {},
  "json": {
    "packageJson.applyConventions": true,
    "jsonTrailingCommaFiles": ["tsconfig.json"]
  },
  "markdown": {},
  "includes": ["**/*.{ts,json,jsonc,md}"],
  "excludes": ["node_modules/**", "dist/**", ".rslib/**", "CHANGELOG.md"],
  "plugins": [
    "npm:@dprint/typescript@0.95.11",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.24.0",
  ],
}
