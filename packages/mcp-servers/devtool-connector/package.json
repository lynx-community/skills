{
  "name": "@lynx-js/devtool-connector",
  "version": "0.19.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/mcp-servers/devtool-connector"
  },
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#daemon-entry": "./src/daemon/entry.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./command": "./src/command/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./streams": "./src/streams/index.ts",
    "./transport": "./src/transport/index.ts",
    "./test-with-client": {
      "types": "./test/testWithClient.ts",
      "import": "./test/testWithClient.ts",
      "default": "./test/testWithClient.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "public"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 'e2e/**/*.test.ts'",
    "test:e2e:public": "node --test --test-concurrency=1 'e2e/public/**/*.test.ts'",
    "format:check": "dprint check --config dprint.jsonc",
    "format": "dprint fmt --config dprint.jsonc"
  },
  "dependencies": {
    "@lynx-js/debug-metadata": "0.1.0",
    "@yume-chan/adb": "catalog:adb"
  },
  "devDependencies": {
    "@rslib/core": "catalog:rstack",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@yume-chan/adb-server-node-tcp": "catalog:adb",
    "@yume-chan/stream-extra": "catalog:adb",
    "dprint": "^0.64.3",
    "jpeg-js": "^0.4.4",
    "obug": "^2.2.1",
    "plist": "^5.1.1",
    "rsbuild-plugin-publint": "^1.0.0",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "ws": "^8.22.2"
  },
  "engines": {
    "node": ">=18.19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
      "#daemon-entry": "./dist/daemon/entry.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./command": "./dist/command/index.js",
      "./daemon": "./dist/daemon/index.js",
      "./streams": "./dist/streams/index.js",
      "./transport": "./dist/transport/index.js",
      "./package.json": "./package.json"
    }
  }
}
