{
  "name": "@lynx-js/devtool-mcp-server",
  "version": "0.18.1",
  "description": "A mcp server that lets coding agents to control, operate and preview Lynx pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/mcp-servers/devtool-mcp-server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./_internal/mcp": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./_internal/schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./_internal/tools": {
      "types": "./src/tools/index.ts",
      "import": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    },
    "./_internal/utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": "./src/main.ts",
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "rslib build",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 'e2e/**/*.test.ts'"
  },
  "dependencies": {
    "@lynx-js/devtool-connector": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp_sdk",
    "@rslib/core": "catalog:rstack",
    "@types/node": "^24.19.4",
    "@yume-chan/adb-server-node-tcp": "catalog:adb",
    "core-js": "^3.51.0",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": { "@modelcontextprotocol/sdk": "*", "zod": "^4.6.5" },
  "peerDependenciesMeta": { "@modelcontextprotocol/sdk": { "optional": true } },
  "engines": { "node": ">=18.19" },
  "publishConfig": {
    "access": "public",
    "bin": "./dist/main.js",
    "exports": {
      "./_internal/mcp": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./_internal/schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js",
        "default": "./dist/schema/index.js"
      },
      "./_internal/tools": {
        "types": "./dist/tools/index.d.ts",
        "import": "./dist/tools/index.js",
        "default": "./dist/tools/index.js"
      },
      "./_internal/utils": {
        "types": "./dist/utils/index.d.ts",
        "import": "./dist/utils/index.js",
        "default": "./dist/utils/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
