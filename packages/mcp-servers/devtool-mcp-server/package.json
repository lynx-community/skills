{
  "name": "@lynx-js/devtool-mcp-server",
  "version": "0.17.1",
  "description": "A mcp server that lets coding agents to control, operate and preview Lynx pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/mcp-servers/devtool-mcp-server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connector": "./src/connector.ts",
    "./schema": "./src/schema/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": "./src/main.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 'e2e/**/*.test.ts'"
  },
  "dependencies": {
    "@lynx-js/devtool-connector": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp_sdk",
    "@rslib/core": "catalog:rstack",
    "@types/node": "^24.19.2",
    "@yume-chan/adb-server-node-tcp": "catalog:adb",
    "core-js": "^3.51.0",
    "rsbuild-plugin-publint": "^1.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.19"
  },
  "publishConfig": {
    "access": "public",
    "bin": "./dist/main.js",
    "exports": {
      ".": "./dist/index.js",
      "./connector": "./dist/connector.js",
      "./schema": "./dist/schema/index.js",
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
