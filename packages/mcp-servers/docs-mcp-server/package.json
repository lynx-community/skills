{
  "name": "@lynx-js/docs-mcp-server",
  "version": "0.2.8",
  "description": "A MCP Server providing Lynx documentation resources for LLMs, with carefully designed prompting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/mcp-servers/docs-mcp-server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./_internal/docs": {
      "types": "./dist/src/docs.d.ts",
      "import": "./src/docs.ts",
      "default": "./src/docs.ts"
    },
    "./_internal/mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./src/mcp.ts",
      "default": "./src/mcp.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": "./main.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "main.ts",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp_sdk",
    "commander": "^15.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.4",
    "obug": "^3.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": "./dist/main.js",
    "exports": {
      "./_internal/docs": {
        "types": "./dist/src/docs.d.ts",
        "import": "./dist/src/docs.js",
        "default": "./dist/src/docs.js"
      },
      "./_internal/mcp": {
        "types": "./dist/src/mcp.d.ts",
        "import": "./dist/src/mcp.js",
        "default": "./dist/src/mcp.js"
      },
      "./package.json": "./package.json"
    }
  }
}
