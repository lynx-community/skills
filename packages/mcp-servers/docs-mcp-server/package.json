{
  "name": "@lynx-js/docs-mcp-server",
  "version": "0.2.6",
  "description": "A MCP Server providing Lynx documentation resources for LLMs, with carefully designed prompting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-community/skills.git",
    "directory": "packages/mcp-servers/docs-mcp-server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./src/mcp.ts",
      "default": "./src/mcp.ts"
    },
    "./docs": {
      "types": "./dist/src/docs.d.ts",
      "import": "./src/docs.ts",
      "default": "./src/docs.ts"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./src/mcp.ts",
      "default": "./src/mcp.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": "./main.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "main.ts",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.4",
    "obug": "^2.2.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": "./dist/main.js",
    "exports": {
      ".": {
        "types": "./dist/src/mcp.d.ts",
        "import": "./dist/src/mcp.js",
        "default": "./dist/src/mcp.js"
      },
      "./docs": {
        "types": "./dist/src/docs.d.ts",
        "import": "./dist/src/docs.js",
        "default": "./dist/src/docs.js"
      },
      "./mcp": {
        "types": "./dist/src/mcp.d.ts",
        "import": "./dist/src/mcp.js",
        "default": "./dist/src/mcp.js"
      },
      "./package.json": "./package.json"
    }
  }
}
