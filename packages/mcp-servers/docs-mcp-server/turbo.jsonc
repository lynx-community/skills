{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["opensource"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "env": [],
      "inputs": [
        "main.ts",
        "src/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.json",
      ],
      "outputs": ["dist/**"],
    },
  },
}
