{
  "name": "@lynx-js/skills-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Lynx skills",
  "license": "Apache-2.0",
  "author": {
    "name": "lynx"
  },
  "type": "module",
  "files": [
    "plugins",
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "pnpm --filter @lynx-js/marketplace-lynx-agent-skills build",
    "eval:skill:check": "node scripts/skill-eval/check_evals.mjs",
    "eval:skill:check:all": "node scripts/skill-eval/check_evals.mjs --all",
    "eval:skill:comment-report": "node scripts/skill-eval/build_comment_report.mjs",
    "eval:skill:setup-opencode-ark": "node scripts/skill-eval/setup-opencode-ark.mjs",
    "eval:skill:task:online": "node scripts/skill-eval/run_task_online.mjs",
    "eval:skill:task:online:all": "node scripts/skill-eval/run_task_online_all.mjs",
    "eval:skill:trigger:online": "node scripts/skill-eval/run_trigger_online.mjs",
    "eval:skill:trigger:online:all": "node scripts/skill-eval/run_trigger_online_all.mjs",
    "lint": "rslint --config rslint.config.mjs . && pnpm --filter @lynx-js/devtool-connector run format:check",
    "prepare": "husky && turbo build",
    "release": "turbo build && pnpm run build && pnpm -r publish --access public --no-git-checks",
    "test": "pnpm -r --if-present test"
  },
  "nano-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,cjs,mjs}": [
      "rslint --config rslint.config.mjs --fix",
      "dprint fmt --allow-no-files --"
    ],
    "*.{css,sass,scss,less,html,yml,yaml,rs,toml,md,json,jsonc}": [
      "dprint fmt --allow-no-files --"
    ],
    "packages/mcp-servers/devtool-connector/**/*.{ts,json,jsonc,md}": [
      "dprint fmt --config packages/mcp-servers/devtool-connector/dprint.jsonc --allow-no-files --"
    ]
  },
  "devDependencies": {
    "@rslint/core": "^0.10.1",
    "dprint": "^0.65.0",
    "eslint-plugin-headers": "^1.3.5",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "pkg-pr-new": "^0.0.94",
    "turbo": "2.11.13",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.29.0"
}
