{
  "name": "@lynx-js/marketplace-lynx-agent-skills",
  "version": "0.1.1",
  "private": true,
  "description": "Lynx skills",
  "license": "Apache-2.0",
  "author": {
    "name": "lynx"
  },
  "type": "module",
  "files": [
    "plugins",
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "build-marketplace && node ./export-skills.mjs",
    "check": "biome check && eslint .",
    "eval:skill:check": "node scripts/skill-eval/check_evals.mjs",
    "eval:skill:check:all": "node scripts/skill-eval/check_evals.mjs --all",
    "eval:skill:comment-report": "node scripts/skill-eval/build_comment_report.mjs",
    "eval:skill:setup-opencode-ark": "node scripts/skill-eval/setup-opencode-ark.mjs",
    "eval:skill:task:online": "node scripts/skill-eval/run_task_online.mjs",
    "eval:skill:task:online:all": "node scripts/skill-eval/run_task_online_all.mjs",
    "eval:skill:trigger:online": "node scripts/skill-eval/run_trigger_online.mjs",
    "eval:skill:trigger:online:all": "node scripts/skill-eval/run_trigger_online_all.mjs",
    "lint": "eslint . --fix && biome check --write",
    "prepare": "husky && turbo build",
    "release": "turbo build && pnpm run build && pnpm changeset publish",
    "test": "pnpm -r --if-present test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,css,sass,scss,less,html,yml,yaml,rs,toml,md,json}": [
      "eslint --cache --fix --no-warn-ignored"
    ],
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@lynx-js/ai-plugin-lynx-debug": "workspace:*",
    "@lynx-js/ai-plugin-reactlynx": "workspace:*",
    "@lynx-js/skill-habitat-usage": "workspace:*",
    "@lynx-js/skill-lynx-a2ui": "workspace:*",
    "@lynx-js/skill-lynx-api-docs": "workspace:*",
    "@lynx-js/skill-lynx-check-css-support": "workspace:*",
    "@lynx-js/skill-lynx-debug-info-remapping": "workspace:*",
    "@lynx-js/skill-lynx-devtool": "workspace:*",
    "@lynx-js/skill-lynx-openui": "0.0.1",
    "@lynx-js/skill-lynx-trace-analysis": "0.0.6",
    "@lynx-js/skill-lynx-trace-record": "0.0.3",
    "@lynx-js/skill-lynx-typescript": "workspace:*",
    "@lynx-js/skill-lynx-ui": "3.133.4",
    "@lynx-js/skill-reactlynx-best-practices": "workspace:*",
    "@lynx-js/skill-rspeedy-bundle-size": "workspace:*",
    "@lynx-js/skill-vanilla-lynx": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@changesets/cli": "^2.29.8",
    "build-marketplace": "workspace:*",
    "build-plugin": "workspace:*",
    "eslint": "^9.39.2",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-headers": "^1.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "pkg-pr-new": "^0.0.87",
    "sort-package-json": "^3.4.0",
    "turbo": "^2.7.5",
    "typescript-eslint": "^8.55.0",
    "yaml": "^2.8.2"
  },
  "packageManager": "pnpm@10.18.2"
}
