{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["GIT_SSH_COMMAND", "XDG_CONFIG_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@lynx-js/marketplace-lynx-agent-skills#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/.claude-plugin/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
